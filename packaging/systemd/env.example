# Environment file for triage-agent.service (installed as /etc/triage-agent/env).
# Each variable holds one whole flag, without spaces inside the value; a
# variable that is unset or commented out is left off the command line.
# systemd reads this file when the service starts: after an edit run
#   systemctl restart triage-agent

# Core WebSocket URL (required). wss:// only, unless TA_EXTRA adds
# --core-allow-plaintext for a trusted network.
TA_ENDPOINT=--triage-endpoint=wss://triage.example.internal/events/ws

# Tenant this host belongs to (required): a host has no namespaces to derive
# one from.
TA_TENANT=--target-tenant=acme

# Fingerprint of the core's agent CA (SHA256:...), from `triagectl agent list`
# on the core side. Required: the agent refuses to start without it, since it
# authenticates to the core only by its join certificate. The certificate is
# issued for a one-time agent key placed in <join state dir>/enroll.key
# (packaging/install.sh does this), or after an admin approves the request
# with `triagectl agent approve`.
TA_JOIN_CA_FINGERPRINT=--join-ca-fingerprint=SHA256:replace-with-the-fingerprint

# Where the agent key, its certificate and the saved core CA live. Losing it
# means a new approval. The unit only allows writes to /var/lib/triage-agent/join;
# if you change this, change ReadWritePaths= in the unit (a drop-in is best).
#TA_JOIN_STATE_DIR=--join-state-dir=/var/lib/triage-agent/join

# Name the core shows for this host. Default: the OS host name.
#TA_CLUSTER_NAME=--cluster-name=web-01

# The one synthetic namespace every unit of this host reports under. Hosts
# running the same services share one value so the services merge in the core
# graph. Default: host.
#TA_NAMESPACE=--host-namespace=host

# Comma-separated globs of the systemd units to observe. Default: every enabled
# service except a built-in denylist (systemd-*, dbus, ssh*, cron, getty@*, ...).
#TA_UNITS=--host-units=nginx.service,app-*.service

# Plain log files a service writes instead of journald, as <unit>=<glob>;
# comma-separate several.
#TA_LOG_FILES=--host-log-files=app-demo=/var/log/app-demo/*.log

# Root of the cgroup v2 filesystem the unit cgroups are read from.
#TA_CGROUP_ROOT=--cgroup-root=/sys/fs/cgroup

# Collectors are off until enabled. Space-separated flags, none with a space
# inside: log metrics from journald and files (LOG), unit CPU, memory and PSI
# (USE). RED and topology from eBPF (-tags obi builds) are enabled with
# --red-metrics-enabled and --topology-enabled.
TA_COLLECTORS=--log-metrics-enabled --use-metrics-enabled

# Local TUI (ADR-0019): serve it on a loopback address and reach it with an SSH
# tunnel (ssh -L 8088:127.0.0.1:8088 host). Put the admin key in the
# environment, not in a flag: a flag shows in the process list. At least 16
# bytes; without it the TUI has no login. Keep this file readable by root only.
#TA_UI=--ui-listen=127.0.0.1:8088   (add $TA_UI to TA_EXTRA, or list it in ExecStart)
#TRIAGE_AGENT_UI_ADMIN_KEY=

# Any other flag, for example --core-heartbeat=20 or --sensor-tick=15s.
#TA_EXTRA=
